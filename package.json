{
  "name": "newsletter-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app",
    "web"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:app": "bun --filter app dev",
    "dev:web": "bun --filter web dev",
    "build": "bun --filter '*' build",
    "build:app": "bun --filter app build",
    "build:web": "bun --filter web build",
    "lint": "bun --filter '*' lint"
  }
}
